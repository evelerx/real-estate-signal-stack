# Custom market-data provider configuration
# Set these in Vercel Environment Variables (or copy to backend/.env for local startup).
# The Admin console sends the browser-held API key only when Custom Market Data API is enabled.

WAKAD_DATA_API_KEY=replace_with_real_key
WAKAD_DATA_API_KEY_HEADER=X-API-Key
WAKAD_DATA_TIMEOUT_SECONDS=8

# External provider endpoints. The heatmap endpoint is used by Investor Dashboard > Investment Density.
# Expected response shapes:
# - Snapshot: object with at least capital_allocation_score
# - Timeseries: list of { quarter, score, confidence, risk } OR { "series": [...] }
# - Heatmap: list of { id, name, score, city, state, latitude?, longitude?, updated_at? }
#   OR { "rows": [...] }. Score must be a 0-100 investment suitability score.
WAKAD_SNAPSHOT_API_URL=https://provider.example.com/wakad/snapshot
WAKAD_TIMESERIES_API_URL=https://provider.example.com/wakad/timeseries
WAKAD_HEATMAP_API_URL=https://provider.example.com/wakad/heatmap
